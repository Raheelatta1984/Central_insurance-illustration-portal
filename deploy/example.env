# Copy to deploy/local.env and edit. local.env is git-ignored (.gitignore: `.env.*` does not match
# this name — the ignore rule for it is explicit at the end of the file).
#
# These are the same variable names the server and `npm run infra:plan` read; see docs/18.

# --- Postgres (self-managed compose cluster) ---------------------------------
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-before-you-run-this
REPLICATION_PASSWORD=change-me-too
DATABASE_MAX_CONNECTIONS=200
DATABASE_RESERVED_CONNECTIONS=20

# --- The application ---------------------------------------------------------
# What the Node process connects to: the pooler, not Postgres directly.
PGBOUNCER_URL=postgres://portal:change-me-before-you-run-this@localhost:6432/portal
# What migrations and DDL use: the primary, never the pooler.
DATABASE_URL=postgres://portal:change-me-before-you-run-this@localhost:5432/portal
INSTANCE_COUNT=4
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=200
# Set to 1 only if the application really needs SET/LISTEN/temp tables/advisory locks; the plan
# then refuses transaction mode instead of corrupting sessions silently.
APP_USES_SESSION_STATE=0

# --- Read replicas -----------------------------------------------------------
READ_REPLICA_URLS=postgres://readonly:change-me-before-you-run-this@localhost:5433/portal?zone=replica-a,postgres://readonly:change-me-before-you-run-this@localhost:5434/portal?zone=replica-b
MAX_REPLICA_LAG_MS=2000

# --- Cache -------------------------------------------------------------------
MEMCACHED_SERVERS=localhost:11211
MEMCACHED_NAMESPACE=portal
CACHE_DEFAULT_TTL_MS=60000

# --- Image shards and ids ----------------------------------------------------
LOGICAL_SHARDS=1024
SHARD_REPLICAS=1
SHARD_MAP=[{"id":"img-a","zone":"a"},{"id":"img-b","zone":"b"},{"id":"img-c","zone":"c"}]
# Each issuer gets its own 13-bit shard reference; 0–8191, and inside LOGICAL_SHARDS.
ID_SHARD=0
