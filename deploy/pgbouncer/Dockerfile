# A tiny PgBouncer image for the reference topology.
#
# The configuration file is the one generated by `npm run infra:plan -- --ini` from
# `src/core/pgbouncer.ts`; it contains no password. The entrypoint writes userlist.txt from the
# container's environment at start-up (chmod 600) so the credential is never baked into an image
# layer or committed to git.
FROM alpine:3.20

RUN apk add --no-cache pgbouncer

COPY pgbouncer.ini /etc/pgbouncer/pgbouncer.ini
COPY entrypoint.sh /usr/local/bin/pgbouncer-entrypoint
RUN chmod 0755 /usr/local/bin/pgbouncer-entrypoint \
    && mkdir -p /var/log/pgbouncer /var/run/pgbouncer

EXPOSE 6432

# BusyBox nc ships with the base image; PgBouncer's own admin console needs credentials, so a TCP
# check is the honest liveness probe here.
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD nc -z 127.0.0.1 6432 || exit 1

ENTRYPOINT ["/usr/local/bin/pgbouncer-entrypoint"]
