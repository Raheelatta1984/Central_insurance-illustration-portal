{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "installCommand": "echo 'the demo needs no dependencies: every source file is committed'",
  "buildCommand": "node tools/demo-site.mjs",
  "outputDirectory": "site",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/console", "destination": "/console.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/tour", "destination": "/tour.md" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
