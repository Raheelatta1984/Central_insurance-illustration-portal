{
  "name": "central-insurance-illustration-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-native Insurance ERP: unit-linked, takaful, group finance, micro-duration cover",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:ui && npm run build:server && npm run demo:offline",
    "start": "node dist-server/server/main.js",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "fleet": "node tools/fleet.mjs --limit=5",
    "backlog": "node tools/generate-backlog.mjs",
    "tour:doc": "node tools/render-tour.mjs",
    "demo:pack": "node tools/demo-pack.mjs",
    "demo:gallery": "node tools/demo-gallery.mjs",
    "demo:offline": "node tools/offline-build.mjs",
    "demo:record": "node tools/offline-record.mjs",
    "demo:record:journey": "node tools/offline-record-journey.mjs",
    "demo:site": "node tools/demo-site.mjs",
    "lint": "eslint src",
    "test:coverage": "vitest run --coverage",
    "docs:api": "node tools/api-doc.mjs",
    "test:e2e": "node tools/e2e-smoke.mjs",
    "test:e2e:partner": "node tools/partner-portal-e2e.mjs",
    "smoke": "vitest run src/server/main.test.ts src/ui/api.test.ts --reporter=dot",
    "mail:smoke": "node tools/mail-smoke.mjs",
    "infra:plan": "node tools/dataplane.mjs",
    "infra:check": "node tools/dataplane.mjs --check",
    "recon:migrate": "npm run build:server && node tools/reconciliation-migrate.mjs",
    "test:e2e:whats-new": "node tools/whats-new-e2e.mjs",
    "whats-new:sync": "npm run build:server && node tools/whats-new-sync.mjs",
    "whats-new:check": "node tools/whats-new-sync.mjs --check",
    "whats-new:backfill": "npm run build:server && node tools/whats-new-sync.mjs --backfill"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
